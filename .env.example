# Supabase project URL and browser-safe publishable key.
# These identify the project; they are not a Postgres password.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Prisma / Supabase Postgres.
# Connect → Transaction pooler (6543) for DATABASE_URL.
# Connect → Session pooler (5432) for DIRECT_URL, used by migrations.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth. Console → APIs & Services → Credentials → Web client.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Liveblocks. Dashboard → Projects → API keys → Secret.
# Used only on the server by /api/liveblocks-auth. Never expose this in the browser.
LIVEBLOCKS_SECRET_KEY="sk_..."
